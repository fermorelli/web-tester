# SQLite file. Existing local history keeps its original default path.
# DATABASE_PATH=./data/audits.sqlite
# Legacy compatibility: AUDIT_DB_PATH is used only when DATABASE_PATH is unset.
# AUDIT_DB_PATH=./data/audits.sqlite

# Production binding. npm run dev always binds to 127.0.0.1.
# APP_HOST=127.0.0.1
# PORT=3000

# Exact public origin, including scheme and optional port. No trailing path.
# Required for a custom hosted domain; Railway's generated domain is detected.
# APP_ORIGIN=https://your-service.up.railway.app
# Railway volume configuration: DATABASE_PATH=/data/seo-analyzer.db
# Railway provides PORT; APP_HOST=0.0.0.0 is already the Docker default.

# Chrome/Chromium executable used by the homepage Lighthouse lab run.
# Windows example: CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Docker default: CHROME_PATH=/usr/bin/chromium

# Whole Lighthouse run timeout in milliseconds (default 120000, maximum 180000).
# LIGHTHOUSE_TIMEOUT_MS=120000
